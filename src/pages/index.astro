    if (action === 'approve1') {
      busy(true); gate1.hidden = true; badge.hidden = true; line('09:14', '<b>Approved by you</b>', '', 'you'); setState('Running', '', '$0.41');
      sequence([['09:15', 'Pushed branch <b>druks/security-sweep</b>', '$0.42'], ['09:16', 'Opened <b>pull request #142</b> in acme/api', '$0.44']], function () { gate2.hidden = false; setState('Waiting for you', 'wait', '$0.44'); busy(false); gate2.querySelector('[data-act="approve2"]').focus({ preventScroll: true }); }); return;
    }
    if (action === 'approve2' || action === 'skip') {
      busy(true); gate2.hidden = true;
      if (action === 'skip') { line('09:17', 'Skipped the second change', '', 'you'); setState('Done', 'ok', '$0.44'); summary(1, 0, '$0.44', 15); track('demo_complete'); return; }
      line('09:17', '<b>Approved by you</b>', '', 'you'); setState('Running', '', '$0.44');
      sequence([['09:19', 'Pinned 6 actions to a commit, added <b>permissions: contents: read</b>', '$0.58'], ['09:20', 'Opened <b>pull request #143</b> in acme/api', '$0.62']], function () { setState('Done', 'ok', '$0.62'); summary(2, 6, '$0.62', 18); track('demo_complete'); }); return;
    }
    if (action === 'stop') { gate1.hidden = true; badge.hidden = true; line('09:14', '<b>Stopped by you.</b> Nothing was changed', '', 'you'); setState('Stopped', 'stop', '$0.41'); foot.hidden = false; return; }
  });
