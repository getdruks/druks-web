---
import brandLockup from '../foundation/brand-lockup.svg?raw';
import '../styles/global.css';

const siteTitle = 'Druks: AI agents work. You make the call.';
const siteDescription =
  'Druks runs Claude Code and Codex on your recurring engineering work, self-hosted or in the cloud, and asks a person before anything changes.';
const socialImage = 'https://druks.ai/assets/social/druks-og-v3.png';
const socialImageAlt = 'Druks: AI agents work. You make the call. A run waits for your approval.';
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Druks',
  alternateName: 'druks.ai',
  url: 'https://druks.ai/',
};
---

<!doctype html>
<html lang="en" class="snap" data-theme="light" data-theme-resolved="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <link rel="canonical" href="https://druks.ai/" />
    <meta name="theme-color" content="#f7f7f7" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Druks" />
    <meta property="og:url" content="https://druks.ai/" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <link rel="icon" href="/foundation/icons/favicon-light.ico" sizes="32x32" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/foundation/icons/favicon-dark.ico" sizes="32x32" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/foundation/icons/favicon-light.svg" type="image/svg+xml" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/foundation/icons/favicon-dark.svg" type="image/svg+xml" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href="/foundation/icons/apple-touch-icon-light.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/assets/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="b019dd0d-0e8b-4cc2-8b7f-6d612aaa0ed0"
      data-domains="druks.ai,www.druks.ai"
    ></script>
  </head>
<body>

<svg width="0" height="0" style="position:absolute" aria-hidden="true"><symbol id="icon-cloud" viewBox="0 0 24 24"><path d="M7.25 19h9.9a4.4 4.4 0 0 0 .15-8.8 6.25 6.25 0 0 0-12.1 1.7A3.6 3.6 0 0 0 7.25 19Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></symbol></svg>
<a class="skip" href="#content">Skip to content</a>
<canvas class="bg-art" aria-hidden="true" hidden></canvas>
<video class="bg-video" id="bg-video" aria-hidden="true" muted playsinline preload="none" hidden><source src="/assets/clouds-ambient.webm" type="video/webm"></video>
<main>
  <header class="wrap site-top d-transparent-glass">
    <nav class="site-nav" aria-label="Main">
      <a class="brand-lockup" href="/" aria-label="Druks home" set:html={brandLockup}></a>
      <ul id="nav-links">
        <li><a href="#customers">Why</a></li>
        <li><a href="#approval">How</a></li>
        <li><a href="#trust">Trust</a></li>
        <li><a href="#schedules">Setup</a></li>
        <li><a href="#closing">Start</a></li>
        <li><a href="#faq">FAQ</a></li>
        <li><a href="https://docs.druks.ai" data-umami-event="click_docs" data-umami-event-where="nav">Docs</a></li>
        <li><a href="https://github.com/czpython/druks" data-umami-event="click_github" data-umami-event-where="nav">GitHub</a></li>
      </ul>
      <span class="spacer"></span>
      <div class="nav-actions">
        <a class="button primary" href="https://app.druks.ai/sign-in?utm_source=druks.ai&amp;utm_medium=nav" data-umami-event="cta_try_cloud" data-umami-event-where="nav">Try it now <svg class="cloud-icon" aria-hidden="true"><use href="#icon-cloud"/></svg></a>
        <button class="button quiet menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="nav-links"><svg class="menu-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M4 6.5h16M4 12h16M4 17.5h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><svg class="close-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><span class="sr-only">Menu</span></button>
      </div>
    </nav>
  </header>

  <div class="wrap hero" id="content" tabindex="-1">
    <div>
      <h1>AI Agents work. <span class="call">You make the call.</span></h1>
      <p class="lede">Druks finds the work, does it on the tools you already use, and brings the important decisions to you.</p>
      <div class="hero-actions">
        <div class="ctas">
          <a class="button primary" href="https://app.druks.ai/sign-in?utm_source=druks.ai&amp;utm_medium=hero" data-umami-event="cta_try_cloud" data-umami-event-where="hero">Try it now <svg class="cloud-icon" aria-hidden="true"><use href="#icon-cloud"/></svg></a>
        </div>
        <a class="install-cue" href="#install" data-umami-event="click_install_cue">or Install Druks on your AI <svg aria-hidden="true" viewBox="0 0 16 16"><path d="m3.5 6 4.5 4 4.5-4" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      </div>
    </div>

    <div class="bleed">
      <div class="ui" id="demo" aria-label="Interactive example run">
        <div class="ui-side" aria-hidden="true">
          <div class="ws"><span class="ws-name">ACME</span></div>
          <span>Home</span>
          <span class="on">Runs</span>
          <span>Approvals <em class="badge" id="side-badge" style="font-style:normal">1</em></span>
          <span>Schedules</span>
          <span>Projects</span>
          <span>Chat</span>
          <span>Usage</span>
          <span>Settings</span>
        </div>
        <div class="ui-main">
          <div class="ui-head">
            <span class="crumb">Runs / <b>Security sweep</b> · acme/api</span>
            <span class="state wait" id="run-state">Waiting for you</span>
            <span class="meta" id="run-meta">Run 4f2a · $0.41</span>
          </div>
          <div class="ui-body" tabindex="0" role="region" aria-label="Run activity and approval request">
            <ol class="log" id="log" aria-live="polite">
              <li class="ok"><span class="t">09:02</span><span class="m">Read <b>7 Dependabot alerts</b> in acme/api</span><span class="c">$0.08</span></li>
              <li class="ok"><span class="t">09:04</span><span class="m"><b>2 alerts</b> touch code you call</span><span class="c">$0.19</span></li>
              <li class="ok"><span class="t">09:09</span><span class="m">Upgraded 3 packages in a safe workspace. <b>Tests pass</b></span><span class="c">$0.37</span></li>
              <li class="ok"><span class="t">09:10</span><span class="m">Also checked your GitHub Actions and git history</span><span class="c">$0.41</span></li>
            </ol>

            <div class="gate" id="gate1">
              <span class="who">⏸ Waiting for your yes</span>
              <h2>I'd like to upgrade 3 packages in acme/api.</h2>
              <p>This closes 7 vulnerabilities, 2 of them in code you call. Tests pass. No cost while I wait.</p>
              <div id="plan" hidden><p class="plan-ask">Tell me what to change. I will try again and ask you again. The plan now:</p><pre class="diff"><span class="r">-    "jsonwebtoken": "8.5.1",</span>
<span class="a">+    "jsonwebtoken": "9.0.2",</span>
<span class="r">-    "axios": "0.21.1",</span>
<span class="a">+    "axios": "1.7.4",</span>
<span class="r">-    "semver": "5.7.1",</span>
<span class="a">+    "semver": "7.6.3",</span></pre></div>
              <div class="row">
                <button class="button primary" type="button" data-act="approve1" data-umami-event="demo_approve">Approve</button>
                <button class="button secondary" type="button" data-act="plan" data-umami-event="demo_change" aria-expanded="false" aria-controls="plan">Change</button>
                <button class="button secondary" type="button" data-act="stop" data-umami-event="demo_stop">Stop</button>
                <span class="cost">Cost so far $0.41</span>
              </div>
            </div>

            <div class="gate" id="gate2" hidden>
              <span class="who">While I was there…</span>
              <h2>I also found 6 GitHub Actions pinned by tag, and no <code>permissions:</code> block.</h2>
              <p>A changed tag can run someone else's code in your build. I can pin each action to a commit and limit the token. Want a second pull request?</p>
              <div class="row">
                <button class="button primary" type="button" data-act="approve2" data-umami-event="demo_surprise_approve">Approve</button>
                <button class="button secondary" type="button" data-act="skip" data-umami-event="demo_surprise_skip">Skip</button>
              </div>
            </div>

            <div id="done" hidden>
              <div class="summary" id="summary"></div>
            </div>

            <div class="ui-foot" id="ui-foot" hidden>
              <button class="button secondary copy-install" type="button" data-act="copy-install-prompt" data-umami-event="copy_install_prompt" aria-label="Copy install prompt"><svg class="copy-glyph" aria-hidden="true" viewBox="0 0 24 24" fill="none"><rect x="8" y="8" width="12" height="12" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" stroke="currentColor" stroke-width="1.8"/></svg><svg class="check-glyph" aria-hidden="true" viewBox="0 0 24 24" fill="none" hidden><path d="m5 12 4 4L19 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Copy install prompt</button>
              <a class="button secondary" href="https://app.druks.ai/sign-in?utm_source=druks.ai&amp;utm_medium=demo_every_monday" data-umami-event="demo_run_every_monday">Run every Monday</a>
              <a class="button primary" href="https://app.druks.ai/sign-in?utm_source=druks.ai&amp;utm_medium=demo_all_repositories" data-umami-event="demo_run_all_repositories">Run on all your repositories <svg class="cloud-icon" aria-hidden="true"><use href="#icon-cloud"/></svg></a>
            </div>
          </div>
        </div>
      </div>
      

    </div>
    <div class="works" role="group" aria-label="Works with">
      <span class="works-label">Works with</span>
      <ul class="works-list">
        <li><span class="works-icon brand-mark claude-mark-window" aria-hidden="true"><img src="/assets/logos/claude.svg" alt=""></span>Claude Code</li>
        <li><svg class="works-icon brand-mark codex-mark" aria-hidden="true" viewBox="0 0 24 24"><path d="M21.55 10.004a5.416 5.416 0 00-.478-4.501c-1.217-2.09-3.662-3.166-6.05-2.66A5.59 5.59 0 0010.831 1C8.39.995 6.224 2.546 5.473 4.838A5.553 5.553 0 001.76 7.496a5.487 5.487 0 00.691 6.5 5.416 5.416 0 00.477 4.502c1.217 2.09 3.662 3.165 6.05 2.66A5.586 5.586 0 0013.168 23c2.443.006 4.61-1.546 5.361-3.84a5.553 5.553 0 003.715-2.66 5.488 5.488 0 00-.693-6.497v.001zm-8.381 11.558a4.199 4.199 0 01-2.675-.954c.034-.018.093-.05.132-.074l4.44-2.53a.71.71 0 00.364-.623v-6.176l1.877 1.069c.02.01.033.029.036.05v5.115c-.003 2.274-1.87 4.118-4.174 4.123zM4.192 17.78a4.059 4.059 0 01-.498-2.763c.032.02.09.055.131.078l4.44 2.53c.225.13.504.13.73 0l5.42-3.088v2.138a.068.068 0 01-.027.057L9.9 19.288c-1.999 1.136-4.552.46-5.707-1.51h-.001zM3.023 8.216A4.15 4.15 0 015.198 6.41l-.002.151v5.06a.711.711 0 00.364.624l5.42 3.087-1.876 1.07a.067.067 0 01-.063.005l-4.489-2.559c-1.995-1.14-2.679-3.658-1.53-5.63h.001zm15.417 3.54l-5.42-3.088L14.896 7.6a.067.067 0 01.063-.006l4.489 2.557c1.998 1.14 2.683 3.662 1.529 5.633a4.163 4.163 0 01-2.174 1.807V12.38a.71.71 0 00-.363-.623zm1.867-2.773a6.04 6.04 0 00-.132-.078l-4.44-2.53a.731.731 0 00-.729 0l-5.42 3.088V7.325a.068.068 0 01.027-.057L14.1 4.713c2-1.137 4.555-.46 5.707 1.513.487.833.664 1.809.499 2.757h.001zm-11.741 3.81l-1.877-1.068a.065.065 0 01-.036-.051V6.559c.001-2.277 1.873-4.122 4.181-4.12.976 0 1.92.338 2.671.954-.034.018-.092.05-.131.073l-4.44 2.53a.71.71 0 00-.365.623l-.003 6.173v.002zm1.02-2.168L12 9.25l2.414 1.375v2.75L12 14.75l-2.415-1.375v-2.75z"/></svg>Codex</li>
        <li><img src="/assets/logos/github.svg" alt="">GitHub</li>
        <li><img src="/assets/logos/slack.svg" alt="">Slack</li>
        <li><img src="/assets/logos/linear.svg" alt="">Linear</li>
        <li><img src="/assets/logos/jira.svg" alt="">Jira</li>
      </ul>
    </div>
  </div>

  <template id="install-prompt">Install Druks on this machine with https://druks.ai/install.sh. Read the script, then run it. Then run the steps it prints: build the sandbox images and run druks doctor. If a step fails, stop. Show me the failed step and its output. Do not improvise a fix. When druks doctor passes, open http://127.0.0.1:8001 in my browser.</template>
  <template id="install-terminal">curl -fsSL https://druks.ai/install.sh | bash</template>

  <div class="sec" id="customers">
    <div class="wrap">
      <div class="section-content">
      <figure class="quote">
        <img class="quote-photo" src="/assets/sorin-popa.webp" alt="Sorin Popa" width="220" height="220">
        <div>
          <h2 class="quote-title">Why Sherpany runs Druks</h2>
          <blockquote><p><span class="quote-mark" aria-hidden="true">“</span><em>Our adoption of agentic operations stalled because we lacked an orchestrator that could run unattended and be trusted: deployed internally, fully auditable. Druks made that real for engineering, and it’s now reshaping how our Customer Success, Sales and Marketing teams operate.</em><span class="quote-mark" aria-hidden="true">”</span></p></blockquote>
          <figcaption>
            <div class="quote-author">
              <img class="quote-logo" src="/assets/sherpany-logo.svg" alt="Sherpany" width="81" height="28">
              <span class="quote-divider" aria-hidden="true"></span>
              <span><b>Sorin Popa</b>VP of Engineering, Sherpany</span>
            </div>
          </figcaption>
        </div>
      </figure>
      </div>
      <a class="section-next" href="#approval" aria-label="How it works">How it works<svg viewBox="0 0 16 16" aria-hidden="true"><path d="m3 6 5 5 5-5"/></svg></a>
    </div>
  </div>

  <div class="sec" id="approval">
    <div class="wrap">
      <div class="section-content">
      <h2>The work comes to you as one decision.</h2>
      <p class="intro">Druks starts from a schedule, an alert or a button. It stops at the moment that needs a person, and asks you where you already are.</p>
      <div class="places">
        <div class="place-item"><figure>
          <figcaption><span class="place-step" aria-hidden="true">01</span><span class="place-caption"><b>In Slack.</b> Answer from your phone. On Druks Cloud from day one.</span></figcaption>
          <div class="slack">
            <div class="av" aria-hidden="true"><img src="/assets/logos/slack.svg" alt=""></div>
            <div>
              <div class="nm">Druks <small>APP · 09:10</small></div>
              <p>⏸️ acme/api: 3 package upgrades ready. Closes 7 vulnerabilities (2 in code you call). Tests pass.</p>
              <div class="sb"><span class="go">Approve</span><span>Change</span><span>Stop</span></div>
            </div>
          </div>
        </figure></div>
          <span class="places-arrow" aria-hidden="true"><svg viewBox="0 0 112 44"><path d="M5 24C23 13 40 19 55 25s25 3 38-10m-9 1 9-1-1 9"/></svg></span>
        <div class="place-item"><figure>
          <figcaption><span class="place-step" aria-hidden="true">02</span><span class="place-caption"><b>In Claude Code.</b> Approve from the same terminal with Druks MCP.</span></figcaption>
          <div class="term" aria-label="Claude Code session">
            <div class="row2"><span class="u">› anything waiting for me in druks?</span></div>
            <div class="row2">Druks is waiting for your approval on <span class="u">acme/api</span>: upgrade 3 packages, closes 7 vulnerabilities.</div>
            <div class="row2"><span class="u">› approve it</span></div>
            <div class="row2"><span class="acc">✓ Approved.</span> Druks is opening the pull request.</div>
          </div>
        </figure></div>
          <span class="places-arrow" aria-hidden="true"><svg viewBox="0 0 112 44"><path d="M5 24C23 13 40 19 55 25s25 3 38-10m-9 1 9-1-1 9"/></svg></span>
        <div class="place-item"><figure>
          <figcaption><span class="place-step" aria-hidden="true">03</span><span class="place-caption"><b>On the record.</b> Every proposal and decision stays in history with its cost.</span></figcaption>
          <div class="mini">
            <span class="who">✓ Approved by Anna · 09:14</span>
            <p>Pull request #142 opened in acme/api. 3 files changed. Cost $0.44.</p>
            <div class="places-cta">
              <a class="button secondary" href="#install">Install with your AI</a>
              <a class="button primary" href="https://app.druks.ai/sign-in?utm_source=druks.ai&amp;utm_medium=approval" data-umami-event="cta_try_cloud" data-umami-event-where="approval">Try it now <svg class="cloud-icon" aria-hidden="true"><use href="#icon-cloud"/></svg></a>
            </div>
          </div>
        </figure></div>
      </div>
      </div>
      <a class="section-next" href="#trust" aria-label="Security">Security<svg viewBox="0 0 16 16" aria-hidden="true"><path d="m3 6 5 5 5-5"/></svg></a>
    </div>
  </div>

  <div class="sec" id="trust">
    <div class="wrap">
      <div class="section-content">
      <h2>Your code, your keys, your decision.</h2>
      <p class="intro">What Druks does with your work, and what it does not do.</p>
      <ul class="trust-grid">
        <li class="panel trust-card"><h3>Keys stay out of the agent's workspace</h3><p>The agent's workspace never holds your AI or GitHub token. It sees a placeholder. Druks gives the real token only for the call, and it keeps your secrets encrypted.</p></li>
        <li class="panel trust-card"><h3>It picks up where it stopped</h3><p>After a restart or a deploy, a run continues from its last saved step. Finished work does not run again.</p></li>
        <li class="panel trust-card"><h3>Nothing runs while it waits</h3><p>When a run asks you, Druks closes its workspace and waits up to 14 days for your answer. No agent runs, so no AI cost.</p></li>
        <li class="panel trust-card"><h3>One answer counts</h3><p>Each question accepts one answer. A second click or a retry does not approve twice.</p></li>
        <li class="panel trust-card"><h3>Every decision on the record</h3><p>Each proposal, each answer and its cost stay in the run history.</p></li>
        <li class="panel trust-card"><h3>Your server, if you want</h3><p>Self-hosted, your code and your data stay on your machine or your server. You can read all of the source code. <a href="https://github.com/czpython/druks/blob/main/SECURITY.md" data-umami-event="click_security" data-umami-event-where="trust">Report a security problem</a>.</p></li>
      </ul>
      </div>
      <a class="section-next" href="#schedules" aria-label="How to Setup">How to Setup<svg viewBox="0 0 16 16" aria-hidden="true"><path d="m3 6 5 5 5-5"/></svg></a>
    </div>
  </div>

  <div class="sec" id="schedules">
    <div class="wrap">
      <div class="section-content">
      <h2>Set it once. Decide when it matters.</h2>
      <p class="intro">Each process is an app with its own schedule or trigger. Example schedule and run data.</p>
      <div class="tbl-wrap">
        <table class="work">
          <thead><tr><th>Process</th><th>Starts</th><th>Last run</th><th>Result</th><th>Needs</th></tr></thead>
          <tbody>
            <tr><td><b>Security sweep</b><small>Fixes vulnerabilities and hardens your build</small></td><td class="mono">Every Monday 07:00</td><td class="mono">Today, 14 min</td><td>2 pull requests ready</td><td><span class="wait-chip">Your yes</span></td></tr>
            <tr><td><b>Ticket to pull request</b><small>Writes, checks and opens the change</small></td><td class="mono">Ticket labeled "druks"</td><td class="mono">Yesterday, 41 min</td><td>Pull request #188</td><td><span class="done-chip">Approved by Anna</span></td></tr>
            <tr><td><b>Your own process</b><small>A Druks app is a Python package</small></td><td class="mono">You choose</td><td class="mono">—</td><td>—</td><td><a href="https://docs.druks.ai/writing-an-app" data-umami-event="click_app_guide" style="color:var(--text-secondary)">Read the app guide</a></td></tr>
          </tbody>
        </table>
      </div>
      </div>
      <a class="section-next" href="#closing" aria-label="Try it now">Try it now<svg viewBox="0 0 16 16" aria-hidden="true"><path d="m3 6 5 5 5-5"/></svg></a>
    </div>
  </div>

  <div class="wrap closing" id="closing">
    <h2>You make the call.</h2>
    <div class="closing-more">
      <div class="closing-more-panel" id="run-options">
      <div class="compare-cards">
        <article class="panel compare-card">
          <header><h3>Self-hosted</h3><p class="compare-description">Run it yourself: paste one prompt into Claude Code. The Druks chat walks you through the rest.</p></header>
          <div class="compare-visual" aria-hidden="true">
            <svg class="compare-illustration" viewBox="0 0 240 160" focusable="false">
              <rect x="39" y="19" width="162" height="103" rx="8" />
              <rect x="49" y="29" width="142" height="82" rx="3" />
              <path d="M108 123v17m24-17v17m-43 1h86" />
              <path class="illustration-accent" d="m91 58 12 10-12 10m23 0h18" />
            </svg>
          </div>
          <dl class="compare-list">
            <div class="compare-item"><dt>Where Druks runs</dt><dd>On your laptop or your own server</dd></div>
          </dl>
          <div class="install-panel" id="install" role="group" aria-label="Install Druks">
            <p class="install-label" id="install-prompt-label">With your AI: paste this into Claude Code or Codex</p>
