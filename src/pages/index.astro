    });
  });

  function track(name) { try { if (window.umami && window.umami.track) window.umami.track(name); } catch (e) {} }
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var demo = document.getElementById('demo'), log = document.getElementById('log');
  var el = function (id) { return document.getElementById(id); };
  var gate1 = el('gate1'), gate2 = el('gate2'), done = el('done'), foot = el('ui-foot'), plan = el('plan');
  var state = el('run-state'), meta = el('run-meta'), badge = el('side-badge'), timers = [];
  function setState(text, cls, cost) { state.textContent = text; state.className = 'state ' + cls; meta.textContent = 'Run 4f2a · ' + cost; }
  function line(time, html, cost, cls) {
    var item = document.createElement('li'); item.className = (cls || 'ok') + (reduce ? '' : ' new');
    item.innerHTML = '<span class="t">' + time + '</span><span class="m">' + html + '</span><span class="c">' + (cost || '') + '</span>'; log.appendChild(item);
  }
  function sequence(steps, then) {
    var index = 0;
    (function next() { if (index >= steps.length) { then(); return; } var step = steps[index++]; line(step[0], step[1], step[2], step[3]); timers.push(setTimeout(next, reduce ? 0 : 650)); })();
  }
  function summary(prs, risks, cost, min) {
    el('summary').innerHTML = '<div><b>' + prs + '</b><span>pull request' + (prs > 1 ? 's' : '') + '</span></div><div><b>7</b><span>vulnerabilities fixed</span></div><div><b>' + risks + '</b><span>build risks fixed</span></div><div><b>' + cost + '</b><span>total cost · ' + min + ' min</span></div>';
    done.hidden = false; foot.hidden = false;
  }
  function busy(on) { demo.querySelectorAll('.gate .button').forEach(function (button) { button.disabled = on; }); }
  demo.addEventListener('click', function (event) {
    var button = event.target.closest('[data-act]'); if (!button || button.disabled) return;
    var action = button.getAttribute('data-act');
    if (action === 'copy-install-prompt') {
      var command = el('install-prompt').content.textContent.trim();
      var copyGlyph = button.querySelector('.copy-glyph'), checkGlyph = button.querySelector('.check-glyph');
      var copied = function () {
        copyGlyph.hidden = true; checkGlyph.hidden = false;
        button.classList.add('is-copied'); button.setAttribute('aria-label', 'Install prompt copied');
        clearTimeout(button.copyResetTimer);
        button.copyResetTimer = setTimeout(function () {
          copyGlyph.hidden = false; checkGlyph.hidden = true;
          button.classList.remove('is-copied'); button.setAttribute('aria-label', 'Copy install prompt');
        }, 1600);
      };
      var fallbackCopy = function () {
        var field = document.createElement('textarea'); field.value = command;
        field.setAttribute('readonly', ''); field.style.position = 'fixed'; field.style.opacity = '0';
