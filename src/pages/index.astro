  function point() {
    var next = nextTarget(); demo.querySelectorAll('.pointed').forEach(function (button) { button.classList.remove('pointed'); });
    if (!next || next[0].disabled || !demo.offsetParent) { tip.hidden = true; return; }
    var d = demo.getBoundingClientRect(), r = next[0].getBoundingClientRect(); next[0].classList.add('pointed'); tip.textContent = next[1]; tip.hidden = false; tip.style.left = (r.left - d.left) + 'px'; tip.style.top = (r.bottom - d.top + 6) + 'px';
  }
