      history.pushState(null, '', href);
      var navHeight = document.querySelector('.site-top').offsetHeight;
      var top = Math.round(target.getBoundingClientRect().top + scrollY - navHeight);
      scrollTo({ top: Math.max(0, top), behavior: reducedMotion ? 'auto' : 'smooth' });
    });
  });
  document.querySelectorAll('a[href^="https://"], a[href^="http://"]').forEach(function (link) {
    link.target = '_blank';
    link.relList.add('noopener', 'noreferrer');
  });
  var navAnchors = Array.prototype.slice.call(nav.querySelectorAll('#nav-links a[href^="#"]'));
  var navTargets = navAnchors.map(function (link) { return { link: link, target: document.getElementById(link.getAttribute('href').slice(1)) }; }).filter(function (item) { return item.target; });
  function updateCurrentNav() {
    var line = document.querySelector('.site-top').getBoundingClientRect().bottom + 1;
    var active = null, activeTop = -Infinity;
    navTargets.forEach(function (item) {
      var top = item.target.getBoundingClientRect().top;
      if (top <= line && top > activeTop) { active = item.link; activeTop = top; }
    });
    var footer = document.querySelector('.foot');
    if (footer && footer.getBoundingClientRect().top <= line) active = null;
