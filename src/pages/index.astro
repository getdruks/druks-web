              <button class="button icon quiet copy" type="button" data-copy="install-terminal-value" data-umami-event="copy_install_command" aria-label="Copy the terminal install command" title="Copy the terminal install command"><svg class="copy-glyph" aria-hidden="true" viewBox="0 0 24 24" fill="none"><rect x="8" y="8" width="12" height="12" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" stroke="currentColor" stroke-width="1.8"/></svg><svg class="check-glyph" aria-hidden="true" viewBox="0 0 24 24" fill="none" hidden><path d="m5 12 4 4L19 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            </div>
          </div>
