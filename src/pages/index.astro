    });
  }
  addEventListener('scroll', updateCurrentNav, { passive: true });
  addEventListener('resize', updateCurrentNav);
  updateCurrentNav();
  addEventListener('keydown', function (event) { if (event.key === 'Escape' && nav.classList.contains('open')) { setMenu(false); menuButton.focus(); } });

  document.querySelectorAll('a[href^="#install"]').forEach(function (link) {
    link.addEventListener('click', function (event) {
      event.preventDefault();
      var installSlot = document.getElementById(link.getAttribute('href').slice(1));
      if (!installSlot) return;
      installSlot.querySelector('[data-install-value]').focus({ preventScroll: true });
      installSlot.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  });
  // the install box shows the whole prompt and the whole command, so each box grows with its text
  function fitInstallValue(area) { area.style.height = 'auto'; area.style.height = area.scrollHeight + 'px'; }
  document.querySelectorAll('[data-install-source]').forEach(function (area) { area.value = document.getElementById(area.getAttribute('data-install-source')).content.textContent.trim(); fitInstallValue(area); });
  addEventListener('resize', function () { document.querySelectorAll('[data-install-source]').forEach(fitInstallValue); });
  document.querySelectorAll('table.work').forEach(function (table) {
    var heads = Array.prototype.map.call(table.tHead.rows[0].cells, function (th) { return th.lastChild ? th.lastChild.textContent.trim() : ''; });
    Array.prototype.forEach.call(table.tBodies[0].rows, function (row) {
      Array.prototype.forEach.call(row.cells, function (cell, index) { if (cell.tagName === 'TD' && heads[index]) cell.setAttribute('data-l', heads[index]); });
    });
  });
  document.querySelectorAll('[data-copy]').forEach(function (button) {
    button.addEventListener('click', function () {
      var element = document.getElementById(button.getAttribute('data-copy'));
      var label = button.getAttribute('aria-label'), title = button.getAttribute('title');
      function done() {
        document.getElementById('live').textContent = 'Copied to the clipboard';
        button.classList.add('is-copied');
        var copyGlyph = button.querySelector('.copy-glyph'), checkGlyph = button.querySelector('.check-glyph');
        if (copyGlyph && checkGlyph) { copyGlyph.setAttribute('hidden', ''); checkGlyph.removeAttribute('hidden'); }
        button.setAttribute('aria-label', 'Copied to the clipboard'); button.setAttribute('title', 'Copied');
        setTimeout(function () {
          button.classList.remove('is-copied');
          if (copyGlyph && checkGlyph) { copyGlyph.removeAttribute('hidden'); checkGlyph.setAttribute('hidden', ''); }
          if (label) button.setAttribute('aria-label', label); else button.removeAttribute('aria-label');
          if (title) button.setAttribute('title', title); else button.removeAttribute('title');
